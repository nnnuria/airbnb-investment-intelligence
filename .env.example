# Copy to .env (gitignored) and fill in real values.
# Never commit .env.

# Apify token — required by the Idealista scraper.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Gemini API key — used by the agent layer (Regulatory RAG narration,
# Market Analyst narration). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
